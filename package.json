    "start": "next start",
    "lint": "eslint",
    "marks": "node scripts/build-marks.mjs",
    "brands": "node scripts/brands.mjs",
    "fonts": "node scripts/fonts.mjs",
    "render-marks": "node scripts/render-marks.mjs",
    "check-route": "node --no-warnings --import ./scripts/lib/ts-paths.mjs scripts/check-route.ts",
    "oklch": "node --no-warnings --import ./scripts/lib/ts-paths.mjs scripts/oklch.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "opentype.js": "^2.0.0",
    "typescript": "^5"
  }
