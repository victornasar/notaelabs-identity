{
  "name": "notaelabs-identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/brands.ts && next dev",
    "build": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/brands.ts --production && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --import ./scripts/lib/ts-paths.ts --test \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/check.ts",
    "shots": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/shots.ts",
    "brands": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/brands.ts",
    "fonts": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/fonts.ts",
    "render-marks": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/render-marks.ts",
    "check-route": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/check-route.ts",
    "check-brand": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/check-brand.ts",
    "export-figma": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/export-figma.ts",
    "oklch": "node --no-warnings --import ./scripts/lib/ts-paths.ts scripts/oklch.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "opentype.js": "^2.0.0",
    "playwright": "1.64.1",
    "typescript": "^5"
  }
}
